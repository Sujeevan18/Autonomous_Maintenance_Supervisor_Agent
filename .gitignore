# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Testing
.pytest_cache/
.coverage
htmlcov/
*.log

# =============================================================================
# Data files — large CSVs and Parquet files
# Track only sample/seed datasets; exclude all generated processed datasets.
# =============================================================================

# Processed datasets (generated by pipeline — do NOT commit)
Backend/processed/

# Integrated real upstream data (raw from teammates)
Backend/data/Maintenance_Supervisor/integrated/
Backend/data/Maintenance_Supervisor/feedback/
Backend/data/Maintenance_Supervisor/upstream/

# Keep sample dataset tracked (small, seeded, needed for pipeline testing)
!Backend/data/Maintenance_Supervisor/sample/

# =============================================================================
# Model artifacts — joblib, pickle, h5, pt files are large binary files
# =============================================================================
*.joblib
*.pkl
*.pickle
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.pb

# Keep encoder manifests (JSON) — they are small and important
!Backend/artifacts/Maintenance_Supervisor/encoders/encoding_manifest.json
!Backend/artifacts/Maintenance_Supervisor/

# =============================================================================
# Logs — generated at runtime, not versioned
# =============================================================================
Backend/logs/
*.log

# =============================================================================
# Reports and metrics — generated outputs (commit selectively)
# Uncommit this block if you want reports tracked in git.
# =============================================================================
# Backend/reports/
# Backend/metrics/

# =============================================================================
# MLflow tracking
# =============================================================================
mlruns/
mlartifacts/

# =============================================================================
# Experiments — large run artifacts
# =============================================================================
Backend/experiments/Maintenance_Supervisor/runs/
Backend/experiments/Maintenance_Supervisor/archived/

# =============================================================================
# IDE and OS files
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# =============================================================================
# Frontend / Node.js
# =============================================================================
node_modules/
Frontend/node_modules/
Frontend/dist/
Frontend/.vite/
.npm/

# =============================================================================
# Environment files — never commit secrets
# =============================================================================
.env
!.env.example

# =============================================================================
# Jupyter notebooks checkpoints
# =============================================================================
.ipynb_checkpoints/

